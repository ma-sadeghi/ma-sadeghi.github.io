{% comment %}
Minimal repository card that displays:
- Repository name
- Star count
- Description
- Link to GitHub

Uses data fetched by jekyll-get-json from GitHub API
{% endcomment %}

{% assign repo_path = include.repository %}
{% assign repo_url = repo_path | split: '/' %}
{% assign owner = repo_url[0] %}
{% assign repo_name = repo_url[1] %}

{% comment %} Map repository path to data key {% endcomment %}
{% case repo_path %}
  {% when 'PMEAL/OpenPNM' %}
    {% assign repo_data = site.data.repo_openpnm %}
  {% when 'PMEAL/porespy' %}
    {% assign repo_data = site.data.repo_porespy %}
  {% when 'AUTODIAL/AutoEIS' %}
    {% assign repo_data = site.data.repo_autoeis %}
  {% when 'ma-sadeghi/Tortuosity.jl' %}
    {% assign repo_data = site.data.repo_tortuosity %}
  {% when 'ma-sadeghi/poromics' %}
    {% assign repo_data = site.data.repo_poromics %}
  {% when 'PMEAL/BEaTmap' %}
    {% assign repo_data = site.data.repo_beatmap %}
{% endcase %}

<div class="repo-item mb-4 p-3 border rounded">
  <div class="d-flex justify-content-between align-items-start mb-2">
    <h5 class="mb-0">
      <a href="{{ repo_data.html_url }}" target="_blank" class="text-decoration-none">
        {% if site.data.repositories.github_users contains owner %}
          {{ repo_name }}
        {% else %}
          {{ repo_path }}
        {% endif %}
      </a>
    </h5>
    <span class="badge bg-secondary ms-2">
      <i class="fa-solid fa-star"></i> {{ repo_data.stargazers_count }}
    </span>
  </div>

  {% if repo_data.description %}
  <p class="text-muted mb-2">{{ repo_data.description }}</p>
  {% endif %}

  <a href="{{ repo_data.html_url }}" target="_blank" class="btn btn-sm btn-outline-primary">
    View on GitHub <i class="fa-solid fa-arrow-up-right-from-square"></i>
  </a>
</div>
